---
const LINKS = [
  { href: "/#", label: "Inicio" },
  { href: "/#proyectos", label: "Proyectos" },
  { href: "/#experiencia", label: "Experiencia" },
  { href: "/#sobre-mi", label: "Sobre mi" },
];
---

<header
  class="sticky top-0 z-50 flex justify-center items-center w-full max-w-screen-xl mx-auto py-4 sm:py-6 px-4"
>
  <nav
    class="relative flex items-center w-fit gap-1 sm:gap-2 p-2 rounded-2xl bg-neutral-900/80 dark:bg-neutral-950/80 transition-all duration-300 ease-in-out backdrop-blur-md shadow-xl"
    aria-label="Navegación principal"
  >
    {
      LINKS.map((link) => (
        <a
          href={link.href}
          class="block text-white hover:bg-neutral-800 transition-all duration-300 ease-in-out py-1.5 sm:py-2.5 px-2 sm:px-4 rounded-xl text-xs sm:text-base font-medium text-center"
        >
          {link.label}
        </a>
      ))
    }
    <a
      href="/#contacto"
      class="block rounded-xl bg-teal-500 px-2 py-1.5 text-center text-xs font-semibold text-black transition-all duration-300 ease-in-out hover:bg-teal-400 sm:px-4 sm:py-2.5 sm:text-base"
    >
      Contacto
    </a>
  </nav>
</header>
