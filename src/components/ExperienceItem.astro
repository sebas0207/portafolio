---
import LinkInline from "./LinkInline.astro";
import Tag from "./Tag.astro";

interface Props {
  title: string;
  company: string;
  description: string;
  achievements?: string[];
  tags?: string[];
  link?: string;
  date: string;
}

const { title, company, description, achievements = [], tags = [], link, date } =
  Astro.props;
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-black/20 dark:before:border-white/15 before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4]"
>
  <div class="relative pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="text-teal-500 -left-[42px] absolute rounded-full text-5xl"
        >&bull;</span
      >

      <h3 class="text-xl font-bold text-white">{title}</h3>
      <h4 class="font-semibold text-xl text-teal-500">{company}</h4>
      <time class="p-0 m-0 text-sm text-gray-600/80 dark:text-white/80"
        >{date}</time
      >
    </div>
  </div>
  <div
    class="relative flex flex-col gap-4 pb-4 text-base font-normal text-gray-600 dark:text-gray-300 md:col-span-3"
  >
    <p class="m-0 text-pretty leading-relaxed">{description}</p>

    {
      achievements.length > 0 && (
        <ul class="m-0 flex list-none flex-col gap-2 p-0">
          {achievements.map((achievement) => (
            <li class="relative pl-5 text-pretty leading-relaxed before:absolute before:left-0 before:top-[0.65em] before:size-1.5 before:rounded-full before:bg-teal-500 before:content-['']">
              {achievement}
            </li>
          ))}
        </ul>
      )
    }

    {
      tags.length > 0 && (
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <Tag label={tag} />
          ))}
        </div>
      )
    }

    {
      link && (
        <LinkInline href={link}>
          Saber más{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
    }
  </div>
</div>
