---
import Perfil from "./Perfil.astro";
import SobreMi from "./SobreMi.astro";
import Experience from "./Experience.astro";
import TechStack from "./TechStack.astro";
import CaseStudyCard from "./CaseStudyCard.astro";
import ProjectCard from "./ProjectCard.astro";
import Contacto from "./Contacto.astro";
import { CASE_STUDIES, SIDE_PROJECTS } from "../data/projects";

const SECTION_CLASS = "lg:w-[740px] w-full mx-auto pt-20";
const HEADING_CLASS =
  "text-3xl font-semibold mb-6 flex gap-x-3 items-center text-black dark:text-white";
---

<main class="px-4">
  <!-- Perfil -->
  <Perfil />

  <!-- Stack técnico -->
  <section id="stack" class={SECTION_CLASS}>
    <h2 class={HEADING_CLASS}>
      <svg
        class="size-7"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M12 3l8 4.5l-8 4.5l-8 -4.5l8 -4.5"></path><path
          d="M4 12l8 4.5l8 -4.5"></path><path d="M4 16.5l8 4.5l8 -4.5"
        ></path></svg
      >
      Stack técnico
    </h2>
    <TechStack />
  </section>

  <!-- Proyectos: casos de estudio -->
  <section id="proyectos" class={SECTION_CLASS}>
    <h2 class={HEADING_CLASS}>
      <svg
        class="size-8"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M5 7l5 5l-5 5"></path><path d="M13 17l6 0"></path></svg
      >
      Casos de estudio
    </h2>
    <p class="mb-8 max-w-2xl text-base font-normal leading-relaxed text-gray-400">
      Problemas reales que he resuelto en producción, contados como contexto,
      decisión técnica y resultado. Los detalles de negocio quedan fuera por
      confidencialidad.
    </p>
    <div class="flex flex-col gap-6">
      {
        CASE_STUDIES.map((caseStudy, index) => (
          <CaseStudyCard index={index + 1} {...caseStudy} />
        ))
      }
    </div>
  </section>

  <!-- Proyectos personales -->
  <section id="otros-proyectos" class={SECTION_CLASS}>
    <h2 class={HEADING_CLASS}>
      <svg
        class="size-7"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M12 3l-4 7h8z"></path><path
          d="M17 17m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path><path
          d="M4 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z"
        ></path></svg
      >
      Otros proyectos
    </h2>
    <div class="grid grid-cols-1 gap-8">
      {SIDE_PROJECTS.map((project) => <ProjectCard {...project} />)}
    </div>
  </section>

  <!-- Experiencia -->
  <section id="experiencia" class={SECTION_CLASS}>
    <h2 class={HEADING_CLASS}>
      <svg
        class="size-7"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        fill="none"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        ><path stroke="none" d="M0 0h24v24H0z" fill="none"></path><path
          d="M3 7m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v9a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z"
        ></path><path d="M8 7v-2a2 2 0 0 1 2 -2h4a2 2 0 0 1 2 2v2"></path><path
          d="M12 12l0 .01"></path><path d="M3 13a20 20 0 0 0 18 0"></path></svg
      >
      Experiencia laboral
    </h2>
    <Experience />
  </section>

  <!-- Sobre mi -->
  <SobreMi />

  <!-- Contacto -->
  <Contacto />
</main>
